{
  "name": "issue-finder",
  "version": "0.2.0",
  "private": true,
  "description": "Issue finder and bug hunter for any codebase (CLI, library, web app, API, mobile, infra): syncs the primary branch, runs the project like a real user, and reports only reproduced bugs with a confidence score, priority, and difficulty.",
  "repository": {
    "type": "git",
    "url": "https://github.com/ANAMASGARD/issue-finder"
  },
  "license": "GPL-3.0-only",
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-plugin-version.mjs",
    "check-plugin-version": "node scripts/sync-plugin-version.mjs --check",
    "validate": "node scripts/validate-skills.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.30.0"
  },
  "overrides": {
    "@types/node": "^22.0.0"
  },
  "packageManager": "npm@10.9.4"
}
